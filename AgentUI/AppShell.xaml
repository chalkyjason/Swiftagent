<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:AgentUI.Views"
       x:Class="AgentUI.AppShell"
       Shell.FlyoutBehavior="Flyout"
       Shell.FlyoutBackgroundColor="{StaticResource DarkSurface}"
       Shell.FlyoutWidth="280">

    <Shell.FlyoutHeader>
        <Grid Padding="20" HeightRequest="140" BackgroundColor="{StaticResource DarkBackground}">
            <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                <Label Text="Swiftagent"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource CyanAccent}" />
                <Label Text="Multi-Agent Task Control Panel"
                       FontSize="12"
                       TextColor="{StaticResource MutedText}" />
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <FlyoutItem Title="Dashboard" Icon="{x:Null}">
        <ShellContent ContentTemplate="{DataTemplate views:DashboardPage}" Route="dashboard" />
    </FlyoutItem>

    <FlyoutItem Title="Tasks" Icon="{x:Null}">
        <ShellContent ContentTemplate="{DataTemplate views:BacklogPage}" Route="tasks" />
    </FlyoutItem>

    <FlyoutItem Title="Agents" Icon="{x:Null}">
        <ShellContent ContentTemplate="{DataTemplate views:OpenClawPage}" Route="agents" />
    </FlyoutItem>

    <FlyoutItem Title="Skills" Icon="{x:Null}">
        <ShellContent ContentTemplate="{DataTemplate views:SkillsPage}" Route="skills" />
    </FlyoutItem>

    <FlyoutItem Title="Console" Icon="{x:Null}">
        <ShellContent ContentTemplate="{DataTemplate views:ConsolePage}" Route="console" />
    </FlyoutItem>

    <FlyoutItem Title="Safety &amp; Cost" Icon="{x:Null}">
        <ShellContent ContentTemplate="{DataTemplate views:SafetyPage}" Route="safety" />
    </FlyoutItem>

    <FlyoutItem Title="Settings" Icon="{x:Null}">
        <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" Route="settings" />
    </FlyoutItem>

</Shell>
